{
  "sql": "SELECT *, timestamp() AS received_at, clientid() AS client_id, topic(2) AS student FROM 'iot-course/Ruslan_Chernyi/telemetry'",
  "awsIotSqlVersion": "2016-03-23",
  "actions": [
    {
      "dynamoDBv2": {
        "putItem": { "tableName": "iot_telemetry" },
        "roleArn": "arn:aws:iam::<ACCOUNT_ID>:role/iot_rule_ddb_role"
      }
    }
  ],
  "errorAction": {
    "cloudwatchLogs": {
      "logGroupName": "/aws/iot/rules/errors",
      "roleArn": "arn:aws:iam::<ACCOUNT_ID>:role/iot_rule_cw_role"
    }
  }
}
